+int RearParticipationBonusCp() {
+  static const int bonus = []() {
+    const char* value = std::getenv("RAKUYOU_REAR_PARTICIPATION_CP");
+    if (value == nullptr || std::strcmp(value, "0") == 0) return 0;
+    if (std::strcmp(value, "10") == 0) return 10;
+    std::fprintf(stderr, "RAKUYOU_REAR_PARTICIPATION_CP must be 0 or 10\n");
+    std::abort();
+  }();
+  return bonus;
+}
+
+template<Color kColor>
+int RearParticipationCount(const Position& pos) {
+  const Bitboard occ = pos.pieces();
+  const Square king = pos.king_square(kColor);
+  if (pos.AttackersTo(king, occ, ~kColor).any()) return 0;
+  const Bitboard enemy_king_control =
+      pos.AttacksFrom<~kColor, kKing>(pos.king_square(~kColor));
+  Bitboard defenders = pos.pieces(kColor);
+  defenders.reset(king);
+  Bitboard seen;
+  while (defenders.any()) {
+    const Square d = defenders.pop_first_one();
+    if (Square::distance(king, d) > 2) continue;
+    const Bitboard direct = AttacksFrom(pos.piece_on(d), d, occ);
+    Bitboard occ_d = occ;
+    occ_d.reset(d);
+    bool checked_d = false;
+    bool safe_d = false;
+    for (int df = -1; df <= 1; ++df) {
+      const int file = static_cast<int>(d.file()) + df;
+      if (file < 0 || file >= 9) continue;
+      for (int dr = -1; dr <= 1; ++dr) {
+        const int rank = static_cast<int>(d.rank()) + dr;
+        if ((df == 0 && dr == 0) || rank < 0 || rank >= 9) continue;
+        const Square t(static_cast<File>(file), static_cast<Rank>(rank));
+        if (pos.piece_on(t).is(kKing)) continue;
+        if (!direct.test(t)) continue;
+        if (pos.num_controls(~kColor, t) -
+            int(enemy_king_control.test(t)) <= 0) continue;
+        Bitboard rear = pos.SlidersAttackingTo(t, occ_d, kColor);
+        rear &= ~pos.SlidersAttackingTo(t, occ, kColor);
+        rear &= occ_d;
+        rear &= ~seen;
+        if (rear.none()) continue;
+        if (!checked_d) {
+          safe_d = pos.AttackersTo(king, occ_d, ~kColor).none();
+          checked_d = true;
+        }
+        if (!safe_d) break;
+        while (rear.any()) {
+          const Square s = rear.pop_first_one();
+          Bitboard occ_d_s = occ_d;
+          occ_d_s.reset(s);
+          if (pos.AttackersTo(king, occ_d_s, ~kColor).none()) seen.set(s);
+        }
+      }
+      if (checked_d && !safe_d) break;
+    }
+  }
+  return seen.count();
+}
+
+PackedScore RearParticipationScore(const Position& pos) {
+  const int bonus = RearParticipationBonusCp();
+  if (bonus == 0) return PackedScore(0);
+  const int delta = RearParticipationCount<kBlack>(pos)
+                  - RearParticipationCount<kWhite>(pos);
+  const int raw = bonus * delta * kFvScale;
+  return PackedScore(raw, 0, raw, 0);
+}
+
 inline PackedScore EvaluateKingSafety(const Position& pos) {
   PackedScore score_black = EvaluateKingSafety<kBlack>(pos);
   PackedScore score_white = EvaluateKingSafety<kWhite>(pos);
-  return score_black + score_white;
+  return RearParticipationBonusCp() == 0 ? score_black + score_white
+                                         : score_black + score_white + RearParticipationScore(pos);
 }
 
