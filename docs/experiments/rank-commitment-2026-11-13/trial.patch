+int RankCommitmentCp() {
+  static const int cp=[]() {
+    const char* value=std::getenv("RAKUYOU_RANK_COMMITMENT_CP");
+    if (!value || std::strcmp(value,"0")==0) return 0;
+    if (std::strcmp(value,"10")==0) return 10;
+    std::fprintf(stderr,"RAKUYOU_RANK_COMMITMENT_CP must be 0 or 10\n");
+    std::abort();
+  }();
+  return cp;
+}
+
+PackedScore RankCommitmentScore(const Position& pos) {
+  const int cp=RankCommitmentCp();
+  if (!cp) return PackedScore(0);
+  const int delta=int(RankOvercommitment<kWhite>(pos))-int(RankOvercommitment<kBlack>(pos));
+  // Same opening taper as the narrow support term. Boolean once per side.
+  return PackedScore(delta*cp*kFvScale,0,0,0);
+}
