+// Isolated position-only test, not a proof of sustainable defense or counterplay.
+#ifndef RAKUYOU_RANK_COMMITMENT_H_
+#define RAKUYOU_RANK_COMMITMENT_H_
+#include "position.h"
+
+inline Bitboard RankParticipants(const Position& pos, Square target, Color side) {
+  const Bitboard occ = pos.pieces();
+  const Bitboard direct = pos.AttackersTo(target, occ, side);
+  Bitboard participants = direct;
+  Bitboard blockers = direct;
+  while (blockers.any()) {
+    const Square blocker = blockers.pop_first_one();
+    Bitboard without = occ;
+    without.reset(blocker);
+    // One rear slider layer after a direct participant vacates; count once.
+    participants |= pos.SlidersAttackingTo(target, without, side) & without;
+  }
+  return participants;
+}
+
+template<Color kColor>
+bool RankOvercommitment(const Position& pos, Square* witness = nullptr,
+                        int* attackers = nullptr, int* defenders = nullptr) {
+  Bitboard pawns = pos.pieces(kColor, kPawn) & rank_bb<5,5>();
+  const Bitboard majors = pos.pieces(~kColor,kRook,kDragon,kBishop,kHorse);
+  const Bitboard guards = pos.pieces(kColor,kGold,kSilver);
+  while (pawns.any()) {
+    const Square pawn = pawns.pop_first_one();
+    if (pawn.file()==kFile1 || pawn.file()==kFile9) continue;
+    const Bitboard enemy_direct = pos.AttackersTo(pawn,pos.pieces(),~kColor);
+    if ((enemy_direct & majors).none()) continue;
+    Bitboard supporting = pos.AttackersTo(pawn,pos.pieces(),kColor) & guards;
+    bool forward_guard = false;
+    while (supporting.any()) {
+      if (relative_rank(kColor,supporting.pop_first_one().rank())==kRank6)
+        forward_guard = true;
+    }
+    if (!forward_guard) continue;
+    const int a = RankParticipants(pos,pawn,~kColor).count();
+    const int d = RankParticipants(pos,pawn,kColor).count();
+    if (a<=d) continue;
+    if (witness) *witness=pawn;
+    if (attackers) *attackers=a;
+    if (defenders) *defenders=d;
+    return true;
+  }
+  return false;
+}
+#endif
